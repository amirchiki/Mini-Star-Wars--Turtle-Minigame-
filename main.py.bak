print("AMIRIO")

import turtle

        # Setting up the screen
window = turtle.Screen()
window.bgcolor("white")


        # creating our boarder
border = turtle.Turtle()
border.penup()
border.setposition(-300, -300)
border.pendown()
border.pensize(3)

for side in range(4):
    border.forward(600)
    border.left(90)

    border.hideturtle()



        # creating our player
player = turtle.Turtle()
player.color("black")
player.shape("triangle")

        # set speed variable
speed = 1
def turnleft():
    player.left(10)

def turnright():
    player.right(10)

def increasespeed():
    global speed
    speed += 1


turtle.listen()
turtle.onkey(turnleft, "a")
turtle.onkey(turnright, "d")
turtle.onkey(increasespeed, "w")




while True:
    player.forward(speed)

    # boundary checker
    if player.xcor() > 300 or player.xcor() < -300:
        player.right(180)
    if player .ycor() > 300 or player.ycor() < -300:
        player.right(180)

while True:
    player.forward(speed)









delay = input("Press Enter to finish")
